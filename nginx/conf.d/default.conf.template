server {
    listen 443 ssl;
    server_name localhost;

    ssl_certificate ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};

    # Optimisation SSL
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;

    # Authentification
    auth_basic "Accès Adminer Restreint";
    auth_basic_user_file /etc/nginx/.htpasswd;

    # Sécurité
    add_header X-Frame-Options "DENY";
    add_header Content-Security-Policy "default-src 'self'";

    location / {
        proxy_pass http://adminer:${ADMINER_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        
        # Injection CSS - Masque tout SAUF le bouton logout
        sub_filter '</head>' '
        <style>
            /* Masquer éléments indésirables */
            #dbs, #menu > li:not(:last-child), .error, 
            #tables, #breadcrumbs, #lang {
                display: none !important;
            }
            
            /* Style minimaliste pour le menu */
            #menu {
                padding: 0 !important;
                background: transparent !important;
                border: none !important;
                height: auto !important;
            }
            #menu li:last-child {
                float: right;
                margin: 5px 10px 0 0;
            }
            /* Ajustement du contenu principal */
            #content {
                margin-left: 0 !important;
                margin-top: 10px !important;
            }
            /* Optionnel : Rendre le bouton logout plus discret */
            #logout {
                background: #f5f5f5 !important;
                color: #555 !important;
                padding: 3px 8px !important;
                border-radius: 3px !important;
                text-decoration: none !important;
            }
        </style>
        </head>';
        sub_filter_once on;
    }
}
